''' <summary>
''' 工位启用选择
''' </summary>
''' <remarks></remarks>
Private Sub labStationSelect_Click(Index As Integer)
On Error GoTo ErrorHandler
    Dim i, j, ClosedCount As Integer
    If SystemStatus = 0 And UserInfo.AuthList.SiteSelectEn Then
        If CheckSubInterface = False Then  '检查是否有界面未被关闭 郭文鑫 2022-06-06
            Exit Sub
        End If
        If StTestArmParam.TestStationIsUsed(Index + 1) = 1 Then
            For i = 1 To StTestIC.PickArmNum
                If StInputArm.ArmStation(i).HasIC = 1 Or StOutputArm.ArmStation(i).HasIC = 1 Then
                    MsgBox "取放料机械手上有料！"
                    Exit Sub
                End If
            Next
            If StTestArm.ARM2Station(Index + 1).HasIC = 1 Or StTestArm.ARM1Station(Index + 1).HasIC = 1 Then
                MsgBox "测压机械手上有料！"
                Exit Sub
            End If
            If StShuttleA.InShuttleStation(Index + 1).HasIC = 1 Or StShuttleA.OutShuttleStation(Index + 1).HasIC = 1 _
            Or StShuttleB.InShuttleStation(Index + 1).HasIC = 1 Or StShuttleB.OutShuttleStation(Index + 1).HasIC = 1 Then
                MsgBox "料梭上有料！"
                Exit Sub
            End If
            
            If StHotControl.Set_HeatEn = 1 Then  '20201116修改
                If BTray(7).TrayICNumNow > 0 Then
                    MsgBox "高温盘1有料，请清料后再开关工位！"
                    Exit Sub
                ElseIf BTray(8).TrayICNumNow > 0 Then
                    MsgBox "高温盘2有料，请清料后再开关工位！"
                    Exit Sub
                End If
            End If
            
            For i = 1 To StTestIC.SitesNum
                If StTestArmParam.TestStationIsUsed(i) = 1 And i <> (Index + 1) Then
                    Exit For
                Else
                    ClosedCount = ClosedCount + 1
                End If
            Next
            If ClosedCount = StTestIC.SitesNum Then
                MsgBox "请至少启用一个工位！", vbExclamation
                Exit Sub
            Else
                Me.labStationSelect(Index).BackColor = &HE0E0E0

                StTestArmParam.TestStationIsUsed(Index + 1) = 0
                If StTestArmParam.TestStationIsUsed(Index + 1) = 0 Then
                    StTestArmParam.ARM1TestStationIsUsed(Index + 1) = 0
                    StTestArmParam.ARM2TestStationIsUsed(Index + 1) = 0
                End If
                '20230803 许志尧 开启测试工位加热功能检测后重新刷新页面启动温控
                If StHotControl.Set_HeatFoolproofEn = 1 Then
                    Call CheckStationAllowHeat(2, Index + 1, StTestIC.SiteType)
                    Call CheckCloseStationAllowHeat
                    Call InitHeatOffset
                    Call frmAutoRun.InitAutoRunForm
                    If StHotControl.Set_HeatEn = 1 Then
                        Call TempControl(1)
                    Else
                        Call TempControl(0)
                    End If
                End If
                StTestArm.ARM1Station(Index + 1).HasIC = 0
                StTestArm.ARM2Station(Index + 1).HasIC = 0
                StShuttleA.InShuttleStation(Index + 1).HasIC = 0
                StShuttleA.OutShuttleStation(Index + 1).HasIC = 0
                StShuttleB.InShuttleStation(Index + 1).HasIC = 0
                StShuttleB.OutShuttleStation(Index + 1).HasIC = 0
                If Set_SiteUserlog200En = 0 Then '20240510 张瑞 工位模式记录log为200
                    Call WriteUserOptLog(0, "工位：" & (Index + 1) & "关闭")
                Else
                    Call WriteUserOptLog(0, "工位：" & (Index + 1) & "关闭", "记录200")
                End If
                For i = 0 To 159
                    Me.lbStationBinStatus(i).Caption = ""
                    Me.lbStationBinStatus(i).BackColor = &HFFFFFF
                    Me.lbStationBinStatus2(i).Caption = ""
                    Me.lbStationBinStatus2(i).BackColor = &HFFFFFF
                Next
                '将主界面测试结果显示清空
                Call RemoveAllBinList
            End If
        ElseIf StTestArmParam.TestStationIsUsed(Index + 1) = 0 Then
            If SLT1X3 = 1 And Index = 3 And StTestArmParam.TestStationIsUsed(4) = 0 Then
                Exit Sub
            End If
            For i = 1 To StTestIC.PickArmNum
                If StInputArm.ArmStation(i).HasIC = 1 Or StOutputArm.ArmStation(i).HasIC = 1 Then
                    MsgBox "取放料机械手上有料！"
                    Exit Sub
                End If
            Next
            If StTestArm.ARM2Station(Index + 1).HasIC = 1 Or StTestArm.ARM1Station(Index + 1).HasIC = 1 Then
                MsgBox "测压机械手上有料！"
                Exit Sub
            End If
            If StShuttleA.InShuttleStation(Index + 1).HasIC = 1 Or StShuttleA.OutShuttleStation(Index + 1).HasIC = 1 _
            Or StShuttleB.InShuttleStation(Index + 1).HasIC = 1 Or StShuttleB.OutShuttleStation(Index + 1).HasIC = 1 Then
                MsgBox "料梭上有料！"
                Exit Sub
            End If
            
            Me.labStationSelect(Index).BackColor = &HFF00&
            StTestArmParam.TestStationIsUsed(Index + 1) = 1
            If StTestArmParam.TestStationIsUsed(Index + 1) = 1 Then
                StTestArmParam.ARM1TestStationIsUsed(Index + 1) = 1
                StTestArmParam.ARM2TestStationIsUsed(Index + 1) = 1
            End If
            
            '20230803 许志尧 开启测试工位加热功能检测后重新刷新页面启动温控
            If StHotControl.Set_HeatFoolproofEn = 1 Then
                Call CheckStationAllowHeat(1, Index + 1, StTestIC.SiteType)
                Call CheckCloseStationAllowHeat
                Call InitHeatOffset
                Call frmAutoRun.InitAutoRunForm
                If StHotControl.Set_HeatEn = 1 Then
                    Call TempControl(1)
                Else
                    Call TempControl(0)
                End If
            End If
            If Set_SiteUserlog200En = 0 Then '20240510 张瑞 工位模式记录log为200
                Call WriteUserOptLog(0, "工位：" & (Index + 1) & "开启")
            Else
                Call WriteUserOptLog(200, "001$工位：" & (Index + 1) & "开启", "记录200")        '20240705 王莹莹 工位开启记录Log和报警格式一致，便于客户端解析
            End If
            For i = 0 To 159
                Me.lbStationBinStatus(i).Caption = ""
                Me.lbStationBinStatus(i).BackColor = &HFFFFFF
                Me.lbStationBinStatus2(i).Caption = ""
                Me.lbStationBinStatus2(i).BackColor = &HFFFFFF
            Next
            '将主界面测试结果显示清空
            Call RemoveAllBinList
        End If
        
        If TIF(Index + 1).SMStationIndex <> 0 Then
            Me.labStationSelect(Index).Caption = CStr(TIF(Index + 1).SMStationIndex)
        Else
            Me.labStationSelect(Index).Caption = "NA"
        End If
        Call Mod_DB.UpdateStationSelect(Index + 1, StTestArmParam.TestStationIsUsed(Index + 1), 1)
        
        Call Mod_DB.UpdateARM1StationSelect(Index + 1, StTestArmParam.ARM1TestStationIsUsed(Index + 1), 2) '郭文鑫 2022-03-01 新增单ARM Site功能
        Call Mod_DB.UpdateARM2StationSelect(Index + 1, StTestArmParam.ARM1TestStationIsUsed(Index + 1), 3)
        
       Call InitStationInfo  '20210826 张瑞增加工位关闭后，重新读取
        
        '工位启用设置修改后进行SiteMapCheck                                          '20221020 张剑 offline模式使用模拟测试
        If StInputArmParam.Set_SiteMappingCheckEn = 1 And (StTestIC.UseTestEn = 1 Or (StTestIC.UseTestEn = 0 And StDebugFlag.AnalogFlag = 1)) And (frmAutoRun.btnFRT.Caption = "FT" Or (StInputArmParam.Set_SiteMappingRTCheckEn = 1)) Then
            
            If StInputArmParam.SiteMappingCheckFlag = 0 Then
                StInputArmParam.SiteMappingCheckFlag = 1
                If StInputArmParam.Set_FullSiteMappingEn = 1 Then '2023/12/29 李森 Fullsite工位检测
                    StInputArmParam.FullSiteMappingFlag = 1
                End If
                For i = 1 To StTestIC.PickArmNum
                    StInputArmParam.SiteMappingCheckState(i) = 0
                Next
            End If
        End If
        '250102 金尚辉  工位启用设置修改后，重新进行socket有无自检
        If StSocketCheck.Set_StationEnableStrikeEn = 1 Then
            Call SocketHasICSensorCheckEnable("功能触发$工位启用")
        End If
        StSECSParam.SendECChangeToHostFlag = 1
        Call SendChangeToHost(SECSEvent.Event_SITE_STATION_CHANGE, "SITE_STATION_CHANGE")
        
    End If
Exit Sub
ErrorHandler:
    Call WriteDebugInfoToLog("labStationSelect_Click发生异常,错误号：" & Err.Number & "  错误信息：" & Err.Description & " 错误行号：" & Erl, 1)      '保存错误的信息
End Sub
