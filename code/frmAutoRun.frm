Private Sub IniESDShowLab()
On Error GoTo ErrorHandler
    Dim i As Integer
    stCount.Tab = 7
    lbESD(1).Caption = StESD.ESDName(1, 1)
    lbESDNow(1).Caption = "0.0"
    If Me.lbESD.UBound = 6 Then
        For i = 2 To 6
            Unload lbESD(i)
            Unload lbESDNow(i)
        Next
    End If
    For i = 2 To 6
        Load lbESD(i)
        Load lbESDNow(i)

        
        lbESD(i).Visible = True
        lbESDNow(i).Visible = True
        lbESD(i).Left = lbESD(i - 1).Left
        lbESD(i).Top = lbESD(i - 1).Top + lbESDNow(i - 1).Height + 100
        lbESDNow(i).Left = lbESDNow(i - 1).Left
        lbESDNow(i).Top = lbESDNow(i - 1).Top + lbESDNow(i - 1).Height + 100
        
        If i > 3 Then
            lbESD(i).Caption = StESD.ESDName(2, i - 3)
            lbESDNow(i).Caption = "0.0"
            If StESD.ESDName(2, i - 3) = "预留" Then
                lbESD(i).Visible = False
                lbESDNow(i).Visible = False
            End If
        Else
            lbESD(i).Caption = StESD.ESDName(1, i)
            lbESDNow(i).Caption = "0.0"
            If StESD.ESDName(1, i) = "预留" Then
                lbESD(i).Visible = False
                lbESDNow(i).Visible = False
            End If
        
        End If
    Next
    
    
    stCount.Tab = 0
Exit Sub
ErrorHandler:
    Call WriteDebugInfoToLog("IniESDShowLab发生异常,错误号：" & Err.Number & "  错误信息：" & Err.Description & " 错误行号：" & Erl, 1)      '保存错误的信息
End Sub






