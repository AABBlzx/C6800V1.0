''' <summary>
''' 刷新收料盘的Bin设置
''' </summary>20231113 许峰 推广兼容32Bin
Public Sub InitAutoFormBinToT_32()
    On Error GoTo ErrorHandler
    Dim i, k As Integer
    
    For i = 1 To 6
        Me.txtTrayBin(i - 1).Text = ""
        If BTray(i).FailTrayFlag = 0 Then
            Me.lbTrayBin(i - 1).BackColor = &HFF00&
            Me.txtTrayBin(i - 1).ForeColor = &HFF00&
            For k = 0 To BIN_MAX
                If CurBinset(k) And TrayBit(i) Then
                    If k <> 0 Then
                        Me.txtTrayBin(i - 1).Text = Me.txtTrayBin(i - 1).Text & k & " "
                    Else
                        Me.txtTrayBin(i - 1).Text = Me.txtTrayBin(i - 1).Text & "R" & " "
                    End If
                End If
            Next
        Else
            Me.lbTrayBin(i - 1).BackColor = &HFF&
            Me.txtTrayBin(i - 1).ForeColor = &HFF&
            For k = 0 To BIN_MAX
                If CurBinset(k) And TrayBit(i) Then
                    If k <> 0 Then
                        Me.txtTrayBin(i - 1).Text = Me.txtTrayBin(i - 1).Text & k & " "
                    Else
                        Me.txtTrayBin(i - 1).Text = Me.txtTrayBin(i - 1).Text & "R" & " "
                    End If
                End If
            Next
        End If
        
        '20240105 许峰 32Bin模式下无offline模式可设分bin功能，若16Bin切换为32Bin且StOutputArmParam.Set_BinToAimTrayNo不为0会导致主界面料盘颜色显示异常，故注释下方代码 20230111吕武杰修改颜色需要为红色
        '20240302 王莹莹 32Bin界面增加OffLine模式可设分Bin功能，取消以下内容的屏蔽
        If StOutputArmParam.Set_BinToAimTrayNo <> 0 And StTestArmParam.Set_TestEn = 0 Then
            Me.txtTrayBin(i - 1).ForeColor = &HFF&
            Me.lbTrayBin(i - 1).BackColor = &HFF&
        End If
    Next
    If StOutputArmParam.Set_FixTrayMode <> "000" Then
        For i = 3 To 8
            Me.txtTrayBin(i).Font.Size = 9      '分割盘的字体大小设置，字体变小，否则分盘后显示不下
        Next
        For i = 0 To 2
            Me.txtTrayBin(i).Height = 750
        Next
        For i = 3 To 5
            Me.lbTrayBin(i).Top = 2300
            Me.lbTrayBin(i).Height = 240
            Me.txtTrayBin(i).Top = 2640
            Me.txtTrayBin(i).Height = 600
        Next
        For i = 7 To 9
            Me.txtTrayBin(i - 1).Text = ""          '清空显示内容
            Me.txtTrayBin(i - 1).Visible = True     '分割模式下，新加的分割盘显示出来
            If BTray(i).FailTrayFlag = 0 Then       '显示Bin值
                For k = 0 To BIN_MAX
                    If CurBinset(k) And TrayBit(i) Then
                        If k <> 0 Then
                            Me.txtTrayBin(i - 1).Text = Me.txtTrayBin(i - 1).Text & k & " "
                        Else
                            Me.txtTrayBin(i - 1).Text = Me.txtTrayBin(i - 1).Text & "R" & " "
                        End If
                        Me.lbTrayBin(i - 4).BackColor = &HFF00&
                    End If
                Next
                Me.txtTrayBin(i - 1).ForeColor = &HFF00&  '绿
            Else
                For k = 0 To BIN_MAX
                    If CurBinset(k) And TrayBit(i) Then
                        If k <> 0 Then
                            Me.txtTrayBin(i - 1).Text = Me.txtTrayBin(i - 1).Text & k & " "
                        Else
                            Me.txtTrayBin(i - 1).Text = Me.txtTrayBin(i - 1).Text & "R" & " "
                        End If
                        Me.lbTrayBin(i - 4).BackColor = &HFF&
                    End If
                Next
                Me.txtTrayBin(i - 1).ForeColor = &HFF&  '红
            End If
        Next
        For i = 1 To 3
            If Mid(StOutputArmParam.Set_FixTrayMode, i, 1) = "0" Then
                Me.txtTrayBin(i + 5).Text = ""                          '清除显示Bin值
                Me.txtTrayBin(i + 5).Visible = False                    '控件不可见
                Me.txtTrayBin(i + 2).Height = 1210                       'Fix盘变高高度
                Me.lbTrayBin(i + 2).Caption = "Fix" & i                 '手工盘标签恢复
                If i = 1 Then
                    Me.lbTrayName(7).Caption = "Fix" & i
                Else
                    Me.lbTrayName(i + 8).Caption = "Fix" & i
                End If
            Else
                Me.lbTrayBin(i + 2).Caption = "Fix" & i & "/" & i + 3
                Me.txtTrayBin(i + 2).Height = 600
                If i = 1 Then
                    Me.lbTrayName(7).Caption = "Fix" & i & "/" & i + 3
                Else
                    Me.lbTrayName(i + 8).Caption = "Fix" & i & "/" & i + 3
                End If
            End If
        Next
    Else
        For i = 0 To 2
            Me.txtTrayBin(i).Height = 975
        Next
        For i = 3 To 5
            Me.lbTrayBin(i).Caption = "Fix" & i - 2
            Me.lbTrayBin(i).Top = 2550
            Me.lbTrayBin(i).Height = 240
            Me.txtTrayBin(i).Top = 2880
            Me.txtTrayBin(i).Height = 975
            Me.txtTrayBin(i).Font.Size = 11
            If i = 3 Then
                Me.lbTrayName(7).Caption = "Fix" & i - 2
            Else
                Me.lbTrayName(i + 6).Caption = "Fix" & i - 2
            End If
        Next
        For i = 6 To 8
            Me.txtTrayBin(i).Text = ""
            Me.txtTrayBin(i).Visible = False
        Next
    End If
    Exit Sub
ErrorHandler:
    Debug.Print "InitAutoFormBinToT_32 Error"
    Call WriteDebugInfoToLog("InitAutoFormBinToT_32 发生异常,错误号：" & Err.Number & "  错误信息：" & Err.Description & " 错误行号：" & Erl, 1)      '保存错误的信息

End Sub
