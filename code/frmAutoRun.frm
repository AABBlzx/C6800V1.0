Dim ESDByte() As Byte                   'ESD接受数据
Dim ESDLen As Long                      'ESD数据长度
Dim ESDStr1 As String                   'ESD监视器1数据
Dim ESDStr2 As String                   'ESD监视器2数据
Dim IDStr As String                     '缓存二维码工单' 钟海 250211 只能扫码枪输入
Dim BarCodeFisrtReadTimer(2) As Double  '当按下按键的时间 '钟海 250211 只能扫码枪输入
