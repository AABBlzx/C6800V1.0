Private Sub btnStartLot_Click()
On Error GoTo ErrorHandler
    Dim ProductBatch As String
    Dim answer As String
    If SystemStatus = 0 Then
'        If StTestIC.TestICBatch <> "Default" Then
'            MsgBox ("当前批次正在使用，如要新建，请先结束该批次")
'            Exit Sub
        If Me.txtLotID.Text = "Default" Then
            MsgBox ("Default为默认批次，请输入新的批次名称")
            Exit Sub
        ElseIf Len(Me.txtLotID.Text) = 0 Then
            MsgBox ("请输入新批次信息")
            Exit Sub
        ElseIf Len(Me.txtOPID.Text) = 0 Then
            MsgBox ("请输入OPID信息")
            Exit Sub
        ElseIf Len(Me.txtLotID.Text) > 50 Then
            MsgBox ("批次信息不得超过50个字符，请重新输入")
            Exit Sub
        ElseIf CheckStrHasAllASCII(Me.txtLotID.Text) = False Then
            MsgBox ("批次名称需要ASCII字符，请重新输入要创建的批次名称")
            Exit Sub
        ElseIf InStr(1, Me.txtLotID.Text, ";") > 0 Then '钟海 241231 修复批次名称中含有分号无法保存数据库的问题
            MsgBox ("批次名称中含有非法字符(;)，请重新输入批次名称")
            Exit Sub
        ElseIf Me.FTRTflag(0).Value = Me.FTRTflag(1).Value Then
            MsgBox ("请选择FT或RT")
            Exit Sub
        End If
        If StTestIC.Set_Batch_firstdownloadEn = 1 And StTestIC.BatchfirstdownloadFlag = 0 Then '250109 钟海 主界面快速开批没有卡控给它加上
            MsgBox ("请先下载档案后再新建批次")
            Exit Sub
        End If
        '20230424 王莹莹 新建批次前，先切换相应SoftBin配置，否则批次管理界面显示的SoftBin种类不对
        If StQRCode.Set_HasTrayBarcode = 1 And StQRCode.Set_TrayBarcodeCheckEn = 1 And StQRCode.Set_TestOrSortMachineType = 1 And StQRCode.Set_BatchOrderQR = "" Then
            MsgBox ("工单码为空，请先扫工单码再新建批次")
            Exit Sub
        End If
        
        '250107 钟海 新增抽检功能
        If Me.FTRTflag(1).Value = Checked And Me.chkSample.Value = Checked Then
            MsgBox ("只能FT批次进行抽检，请重新确认批次是否抽检")
            Exit Sub
        End If
        If Me.chkSample.Value = Checked And (StOutputArmParam.SampleCycleNum = 0 Or StOutputArmParam.SampleTrayIndex = 0) Then
            MsgBox ("抽检参数未设置正确，请进入Bin设置界面修改确认相关参数")
            Exit Sub
        ElseIf Me.chkSample.Value = Checked And StOutputArmParam.SampleTotalNum = 0 Then
            answer = MsgBox("抽检总数设置为0，下一个新建的批次会一直执行抽检，确认是否执行抽检?", vbExclamation + vbYesNo, "请确认")
            If answer = vbNo Then
                Exit Sub
            End If
        End If
        If Me.FTRTflag(0).Value = Checked And Me.chkSample.Value = Unchecked And StOutputArmParam.SampleTrayEn = 1 Then
            answer = MsgBox("当前批次是FT,没有勾选抽检，是否继续开批?", vbExclamation + vbYesNo, "请确认")
            If answer = vbNo Then
                Exit Sub
            End If
        End If
        '20220617 高超杰 批次数量监控功能开启 未输入数量时，不进行保存
        If StTestIC.Set_CheckNewLotICNumEn = 1 Then
            If Me.NewLotICNum.Text = "" Or Val(Me.NewLotICNum.Text) < 1 Then
                MsgBox ("请输入新建批次的数量！")
                Exit Sub
            Else
                If IsNumeric(Me.NewLotICNum.Text) = False Then
                    MsgBox "批次数量设置有非数字输入，请检查"
                    Exit Sub
                Else
                    Call Mod_DB.UpdateBaseParam("新建批次IC数量", Me.NewLotICNum.Text)
                    StTestIC.Set_NewLotICNum = Val(Me.NewLotICNum.Text)
                End If
            End If
        Else
            Call Mod_DB.UpdateBaseParam("新建批次IC数量", 0)
            StTestIC.Set_NewLotICNum = 0
        End If

        
        '20240322 王莹莹 主界面增加MTBA显示，推广430 1.9'新建批次时先保存之前批次mtba数据
'400           Call UpdateMtbaSysTimeCalculate  '数据库存储MTBA数据
        Call SysMTBATimeRecord  '文本存储MTBA数据
        '20240322 王莹莹 主界面增加MTBA显示，推广430 1.9'将mtba基础数据赋值为0
        Call ResetMtbaData
        
        ProductBatchhadExsit = 0
        '20240524 王莹莹 新建产品档批次时，名称中有特殊符号时，自动替换为临近字符
        Dim i As Integer
        For i = 1 To Len(Me.txtLotID.Text)
            If Mid(Me.txtLotID.Text, i, 1) = "\" Or Mid(Me.txtLotID.Text, i, 1) = "/" Or Mid(Me.txtLotID.Text, i, 1) = ":" Or Mid(Me.txtLotID.Text, i, 1) = "*" Or Mid(Me.txtLotID.Text, i, 1) = """" Or Mid(Me.txtLotID.Text, i, 1) = "?" Or Mid(Me.txtLotID.Text, i, 1) = "<" Or Mid(Me.txtLotID.Text, i, 1) = ">" Or Mid(Me.txtLotID.Text, i, 1) = "|" Or Mid(Me.txtLotID.Text, i, 1) = "-" Then
                Me.txtLotID.Text = SpecialEncoding(Me.txtLotID.Text)
            End If
        Next
        If Me.txtLotID.Text <> StTestIC.TestICBatch Then
            '250113 钟海 推广 241026 金尚辉 增加Vision同步批次管理
            If StTestArmParam.Set_VisionSynBatchEn = 1 Then
                If StTestArmParam.Set_RTCEn = 1 Then
                    If SetVisionSynWith("StartBatch", 1, Me.txtLotID.Text, "", 1) = 0 Then
                        Exit Sub
                    End If
                ElseIf StQRCode.Set_HasQRCode = 1 And StQRCode.Set_QRCodeCheckEn = 1 Then  '是否拥有二维码功能且已打开
                    If SetVisionSynWith("StartBatch", 2, Me.txtLotID.Text, "", 1) = 0 Then
                        Exit Sub
                    End If
                End If
            End If
            ProductBatch = Me.txtLotID.Text
            StTestIC.TestOPID = Me.txtOPID.Text
            
            Call frmReportForBatch.CheckProductBatch(Me.txtLotID.Text)
            If ProductBatchhadExsit = 1 Then
                Dim answer2 As String
                
                If StTestArmParam.Set_LotAddTime = 0 Then
                    answer2 = MsgBox("此批次已经存在，是否调用存在的批次", vbExclamation + vbYesNo, "请确认")
                    If answer2 = vbYes Then
                    
                        Call Mod_DB.DeleteBatchRecord(ProductBatch)
                        Call Mod_DB.InsertQuickBatch(ProductBatch)
                    Else
                        Exit Sub
                    End If
                    
                Else
                    ProductBatch = ProductBatch & "-" & Format(Now, "yyyy-mm-dd hh-mm-ss")
                    Call Mod_DB.InsertQuickBatch(ProductBatch)
                End If
                
            Else '更新批次的记录信息
                Call Mod_DB.InsertQuickBatch(ProductBatch)
            End If
            StTestIC.TestICBatch = ProductBatch
            StTestIC.BatchJam = 0
            StTestArmParam.NewLotFlag = 1
            StTestArmParam.Set_StartMode = 0
            frmAutoRun.cobStartMode.ListIndex = 1
            Call UpdateBaseParam("新批次标志", 1)
            StTestIC.Set_TestTrayCount = 0
            StTestIC.LotStatus = 1

            Me.txtLotID.Locked = True
            Me.txtOPID.Locked = True
            
            Call UpdateBaseParambyCode("LotStatus", StTestIC.LotStatus)
            
            If UserLanguage = 0 Then
                Call WriteUserOptLog(0, "新建批次：" & StTestIC.TestICBatch)
            Else
                Call WriteUserOptLog(0, "Establish new batch: " & StTestIC.TestICBatch)
            End If
            '250102 金尚辉 新建批次，要重新进行socket有无自检
            If StSocketCheck.Set_CrateNewBatchStrikeEn = 1 Then
                Call SocketHasICSensorCheckEnable("功能触发$新建批次")
            End If
            If StQRCode.Set_2DIDReportEn = 1 And StQRCode.Set_QRCodeCheckEn = 1 And StQRCode.Set_HasQRCode = 1 Then                   '20220713 高超杰 功能开启，新建批次时生成2DID检测报告模板
                Call Write2DIDReportToExcel(1)
            End If
            
            If Me.chkSample.Value = Checked And StOutputArmParam.SampleTrayEn = 1 Then '钟海 250106 新增抽检功能
                StOutputArmParam.SampleTrayFlag = 1
            Else
                StOutputArmParam.SampleTrayFlag = 0
            End If
            StOutputArmParam.SampleCurrentNum = 0
            StOutputArmParam.SampleCurrentCycleNum = 0
            Call UpdateBaseParambyCode("SampleTrayFlag", StOutputArmParam.SampleTrayFlag)
            Call UpdateBaseParambyCode("SampleCurrentNum", StOutputArmParam.SampleCurrentNum)
            
            If Me.FTRTflag(0).Value = Checked Then
                SystemRetestFlag = 0
                frmAutoRun.btnFRT.Caption = "FT"
                frmAutoRun.btnFRT.BackColor = &HFF00&
                frmAutoRun.FRTLabel.Caption = "FT"
                frmAutoRun.FRTLabel.BackColor = &HFF00&
                Call UpdateBaseParam("FT和RT状态", 0)
                Call InitTestParam
                Call InitTestBinInfo                        '初始化测试Bin设置
                
                If StQRCode.Set_HasTrayBarcode = 1 And StQRCode.Set_TrayBarcodeCheckEn = 1 Then
                    '20230325 王莹莹 机台启用料盘二维码功能，需要根据Softbin分盘，主界面各盘中显示SoftBin值（+R）
                    Call frmAutoRun.InitAutoFormSoftBinToT
                    '20230419 王莹莹 新建批次增加读取Excel中Softbin数量
                    Call ReadTestRecordExcel(StTestIC.TestICBatch)
                Else
                    '机台不启用料盘二维码功能，需要根据BinVal分盘，主界面各盘中显示Bin值（1~15+R）
                    Call frmAutoRun.InitAutoFormBinToT
                End If
                
            ElseIf Me.FTRTflag(1).Value = Checked Then
                SystemRetestFlag = 1
                frmAutoRun.btnFRT.Caption = "RT"
                frmAutoRun.btnFRT.BackColor = &HFF&
                frmAutoRun.FRTLabel.Caption = "RT"
                frmAutoRun.FRTLabel.BackColor = &HFF&
                Call UpdateBaseParam("FT和RT状态", 1)
                Call InitTestParam
                Call InitTestBinInfo                        '初始化测试Bin设置
                
                If StQRCode.Set_HasTrayBarcode = 1 And StQRCode.Set_TrayBarcodeCheckEn = 1 Then
                    '20230325 王莹莹 机台启用料盘二维码功能，需要根据Softbin分盘，主界面各盘中显示SoftBin值（+R）
                    Call frmAutoRun.InitAutoFormSoftBinToT
                Else
                    '机台不启用料盘二维码功能，需要根据BinVal分盘，主界面各盘中显示Bin值（1~15+R）
                    Call frmAutoRun.InitAutoFormBinToT
                End If
            End If
            
            If StQRCode.Set_HasTrayBarcode = 1 And StQRCode.Set_TrayBarcodeCheckEn = 1 And StTestIC.TestICBatch <> "Default" Then      '20230524 王莹莹 先输入工单码，再新建批次
                StQRCode.BatchOrderQREnableFlag = 0
            End If

            Call MsgBox("新建批次成功")
            Call SaveTrayWorkRecord
            Call SendChangeToHost(SECSEvent.Event_OPEN_LOT, "OPEN_LOT")  '20240313 姜洲鑫 新增开批事件
        End If
    End If
Exit Sub
ErrorHandler:
    Call WriteDebugInfoToLog("btnStartLot_Click发生异常,错误号：" & Err.Number & "  错误信息：" & Err.Description & " 错误行号：" & Erl, 1)      '保存错误的信息

End Sub

Private Sub CmdTempMode_Click()
On Error GoTo ErrorHandler
    If SystemStatus = 0 Or SystemStatus = 5 Then
        Dim answer As String
        Dim Logstr As String
        If UserInfo.AuthList.SetTempChangeEn = False Then
            Call ClearAlarmShow
            frmAutoRun.lbResolution.Text = "您无权限切换温度模式，请重新登录"
            Exit Sub
        Else
            If frmAutoRun.lbResolution.Text = "您无权限切换温度模式，请重新登录" Then
                frmAutoRun.lbResolution.Text = ""
            End If
        End If
        If UserInfo.Userlevel = 66 Or StTestArmParam.Set_HisiVerEn = 0 Then
'            Call SetUserLogin("czy")
            If StHotControl.Set_HeatEn = 1 Then
                If BTray(7).TrayICNumNow > 0 Then
                    MsgBox (TranslateWords("高温盘1有料，请清料后再切换温度模式！", "frmAutoRun", 158))
                    Exit Sub
                ElseIf BTray(8).TrayICNumNow > 0 Then
                    MsgBox (TranslateWords("高温盘2有料，请清料后再切换温度模式！", "frmAutoRun", 159))
                    Exit Sub
                End If
            End If

            Me.lbSetHeatTemp.Enabled = False
            Me.lbSetHeattime.Enabled = False
            answer = MsgBox("您确定要修改加热功能吗？", vbExclamation + vbYesNo, "请确认")
            If answer = vbYes Then
                If StHotControl.Set_HeatEn = 1 Then
                    Call CoolEnterDelay         '20230620 许志尧 新增冷却气电磁阀延时关闭功能
                    Call TempControl(0)
                    StHotControl.TCHotStopFlag = 1
                    StHotControl.Set_PreHeatEn = StHotControl.Set_HeatEn
                    StHotControl.Set_HeatEn = 0
                    Me.lbHeatEn.Caption = "常温"
                    Me.lbHeatEn.BackColor = &HFFFF80
                    Call Mod_DB.SaveProductParam("Set_HeatEn", StHotControl.Set_HeatEn)
                Else
                    '20230803许志尧 开启测试工位加热功能检测
                    If StHotControl.Set_HeatFoolproofEn = 1 Then
                        Dim i As Integer
                        For i = 1 To StTestIC.SitesNum
                            Call CheckStationAllowHeat(0, i, StTestIC.SiteType)
                        Next
                        Call CheckStationAllowHeat1(1, StTestIC.SiteType)
                        Call CheckCloseStationAllowHeat
                        Call InitHeatOffset
                        Call frmAutoRun.InitAutoRunForm
                    End If
                    StHotControl.Set_PreHeatEn = StHotControl.Set_HeatEn
                    StHotControl.Set_HeatEn = 1
                    Call TempControl(1)
                    Me.lbHeatEn.Caption = "高温"
                    Me.lbHeatEn.BackColor = &HFF&
                    Call Mod_DB.SaveProductParam("Set_HeatEn", StHotControl.Set_HeatEn)
                End If
                StSECSParam.SendECChangeToHostFlag = 1
            End If
            
            If StHotControl.Set_HeatEn = 0 Then
                Me.Frame2.Visible = False
                Me.lbSetHeatTemp.Visible = False
                Me.lbSetHeattime.Visible = False
                Me.lbTempValue(0).Visible = False
                Me.lbTempValue(1).Visible = False
                Me.lbTempTime(0).Visible = False
                Me.lbTempTime(1).Visible = False
                Me.CLeanIC.Visible = False '20210119 增加高温盘一键清料
            Else
                Me.Frame2.Visible = True
                Me.lbSetHeatTemp.Visible = True
                Me.lbSetHeattime.Visible = True
                Me.lbTempValue(0).Visible = True
                Me.lbTempValue(1).Visible = True
                Me.lbTempTime(0).Visible = True
                Me.lbTempTime(1).Visible = True
                Me.CLeanIC.Visible = True '20210119 增加高温盘一键清料
            End If
            Logstr = "TempSet frmAdvTempSet" & "$Set_HeatEn$" & StHotControl.Set_HeatEn & "$Set_HeatTemp$" & StHotControl.Set_HeatTemp
            Call WriteLog("TempSet", Logstr)
            Call InitAutoRunForm
            
        Else
            If LogInwithOneID = 0 Then
                frmLogin.Show
            Else
                frmLogin2.Show
                frmLogin2.btnLogin.SetFocus '2021/9/3 何金泽 修改登录界面需要点击登录才能输入一次
            End If
        End If
    End If
Exit Sub
ErrorHandler:
    Call WriteDebugInfoToLog("CmdTempMode_Click发生异常,错误号：" & Err.Number & "  错误信息：" & Err.Description & " 错误行号：" & Erl, 1)      '保存错误的信息

End Sub



