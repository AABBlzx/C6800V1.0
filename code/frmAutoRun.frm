''' <summary>
''' 刷新系统运行状态
''' </summary>
Private Sub timerAutoRun_Timer()
On Error GoTo ErrorHandler
    Call CheckSECSMode
    Call CheckRTMMode
    Call CheckSRTMMode
    Call CheckFTPMode   '20240104  陈春波  FTP通信连接
    Call CheckXJReport  '20240426  陈增亮  新增矽佳报表上传
    Call ShowStatusBar
    Call UpdatUser      '20220928 华继山 新增判断是否自动更新UserInfo
    Call RunTimeSum  '20230703 沈延 推广 20230105 沈延 刷新元器件定时器
    Call ShowMtbaRunStatus      '20240322 王莹莹 主界面增加MTBA显示，推广430 1.9
    
    If SystemStopFlag = 1 And SystemAlarmPauseFlag = 0 Then '停止标志位为1，且异常停止标志位为0
        If StActionLoop.LoadTrayFlag = 0 And StActionLoop.InputArmFlag = 0 And StActionLoop.ShuttleAFlag = 0 And StActionLoop.ShuttleBFlag = 0 _
        And StActionLoop.TestArmFlag = 0 And StActionLoop.OutputArmFlag = 0 And StActionLoop.UnloadTray1Flag = 0 And StActionLoop.UnloadTray2Flag = 0 _
        And StActionLoop.UnloadTray3Flag = 0 And StActionLoop.TrayArmFlag = 0 Then
            Call SystemStopShow
            Me.lbSystemStatus = "停止"
            Call Timer_Reset(T_CheckHeatStop)
            By(OY_Sys_GreenLight).StateNow = 0
            Me.lbSystemStatus.ForeColor = &H0&

            Me.cmdStartRunMode.Enabled = True
            frmAutoRun.cmdTestMode.Enabled = True
            frmAutoRun.cmdRunMode.Enabled = True
            StTrayArmParam.FindZeroFlag = 0
            SystemStatus = 0
            SystemStopFlag = 0
            SystemPauseFlag = 0
            DebugHomeFlag = 0

            Dim i As Integer
            For i = 1 To 10
                frmAutoRun.btnMenu(i).Enabled = True
            Next
            If StOutputArmParam.Set_EQCenableEn = 1 Then '20250318 梁子旋 根据客户要求需要一直置灰chkSample
                Me.chkSample.Enabled = True '钟海 20250123 新增抽检功能
            End If
            Call InitAutoRunForm
            If SysInitForBatchNumFlag = 1 Then
                SysInitForBatchNumFlag = 0
                Call SystemStart
            End If
            Call SaveTrayWorkRecord
            If frmAutoRun.lbAlarmIndex.Caption <> "" Then
                Call ClearAllAlarm
                frmAutoRun.lbAlarmIndex.Caption = ""
                frmAutoRun.lbAlarmName.Caption = ""
                frmAutoRun.txtBelongPart.Text = ""
                frmAutoRun.lbResolution.Text = ""
                frmAutoRun.btnAlarmConfirm.BackColor = &H8000000F
                frmAutoRun.btnAlarmRetry.BackColor = &H8000000F
            End If
            By(OY_Sys_DoorLock).StateNow = 0
            If StActionLoop.CleanOutFlag = 1 Then
                'StButtonLight.TrayFeed = 2
                StActionLoop.CleanOutFlag = 0
                StButtonLight.CleanOut = 0
            End If
            Call ActionInit
            '2013.11.29,panxz,关闭AlarmReset和CleanOut灯闪烁
            StButtonLight.CleanOut = 0
            StButtonLight.AlarmReset = 0
            StButtonLight.Start = 0
            StButtonLight.Skip = 0
            StButtonLight.Retray = 0
            StButtonLight.Onecycle = 0
            StButtonLight.Pause = 0
            StButtonLight.Reset = 1
            StButtonLight.TrayFeed = 0
            StButtonLight.TrayEnd = 0
            StButtonLight.CleanOut = 0
        End If
    End If
    
    '20240322 王莹莹 增加，ART功能和拼盘功能时，有报警可刷新为异常停止
    '20231206 张庆磊 预温过程中发生异常，无法刷新为异常停止
    If SystemAlarmPauseFlag = 1 And (frmAutoRun.lbSystemStatus.Caption = "Hot Clean" Or Me.lbSystemStatus.Caption = "运行" Or Me.lbSystemStatus.Caption = "Home" Or Me.lbSystemStatus.Caption = "TrayFeed" _
    Or Me.lbSystemStatus.Caption = "正在停止" Or Me.lbSystemStatus.Caption = "OneCycle" Or Me.lbSystemStatus.Caption = "暂停" Or Me.lbSystemStatus.Caption = "拼盘" Or Me.lbSystemStatus.Caption = "FailRetest" _
    Or Me.lbSystemStatus.Caption = "Cleaning" Or Me.lbSystemStatus.Caption = "Clean Out" Or Mid(Me.lbSystemStatus.Caption, 1, 4) = "Heat" Or Mid(Me.lbSystemStatus.Caption, 1, 4) = "Wait") Then
         If StActionLoop.LoadTrayFlag = 0 And StActionLoop.InputArmFlag = 0 And StActionLoop.ShuttleAFlag = 0 And StActionLoop.ShuttleBFlag = 0 _
        And StActionLoop.TestArmFlag = 0 And StActionLoop.OutputArmFlag = 0 And StActionLoop.UnloadTray1Flag = 0 And StActionLoop.UnloadTray2Flag = 0 _
        And StActionLoop.UnloadTray3Flag = 0 And StActionLoop.TrayArmFlag = 0 Then
            If CheckMotoMoving = 0 Then
                If StErrorTowerLight.GreenLightEn = 1 Then
                    By(OY_Sys_GreenLight).StateNow = 1
                Else
                    By(OY_Sys_GreenLight).StateNow = 0
                End If
                If StErrorTowerLight.YellowLightEn = 1 Then
                    By(OY_Sys_YellowLight).StateNow = 1
                Else
                    By(OY_Sys_YellowLight).StateNow = 0
                End If
                If StErrorTowerLight.RedLightEn = 1 Then
                    By(OY_Sys_RedLight).StateNow = 1
                Else
                    By(OY_Sys_RedLight).StateNow = 0
                End If

                Me.lbSystemStatus = "异常停止"

                frmAutoRun.lbSystemStatus.ForeColor = &HFF&
                Me.btnMenu(10).Enabled = True
                Me.btnMenu(7).Enabled = True
                Me.btnMenu(5).Enabled = True
                Me.btnMenu(3).Enabled = True
                Me.btnMenu(2).Enabled = True            '20211214  李俊辉  异常停止显示测试设置界面
                Call SaveTrayWorkRecord
                By(OY_Sys_DoorLock).StateNow = 0
                StButtonLight.Start = 0
                StButtonLight.AlarmReset = 2
                If AlarmMsgList(AlarmList(StAlarm.ShowAlarmNo).AlarmNo).SkipEn = 1 Then
                    StButtonLight.Skip = 2
                End If
                If AlarmMsgList(AlarmList(StAlarm.ShowAlarmNo).AlarmNo).RetrayEn = 1 Then
                    StButtonLight.Retray = 2
                End If
                If AlarmList(StAlarm.ShowAlarmNo).AlarmNo = ABN_InputArm_ICWeiXiQi Then
                    StButtonLight.Onecycle = 2
                    StButtonLight.TrayEnd = 2
                ElseIf AlarmList(StAlarm.ShowAlarmNo).AlarmNo = ABN_LoadTray_WuLiaoPan Then
                    StButtonLight.Onecycle = 2
                    If StButtonLight.CleanOut <> 1 Then
                        StButtonLight.CleanOut = 2
                    End If
                ElseIf AlarmList(StAlarm.ShowAlarmNo).AlarmNo = ABN_InputArm_OneCycleFinished Then
                    StButtonLight.Onecycle = 0
'                    If StButtonLight.CleanOut <> 1 Then'20221108 何金泽 cleanout不清高温盘，所以未避免出现这种情况，只允许无料盘后点cleanout
'                        StButtonLight.CleanOut = 2
'                    End If
                    If StButtonLight.CleanOut <> 1 Then     '20221122 李俊辉 新增需求OneCycle结束可以点Cleanout,清供料盘及高温盘
                        StButtonLight.CleanOut = 2
                    End If
                End If
                If AlarmList(StAlarm.ShowAlarmNo).AlarmNo = ABN_TrayArm_ZhenKongYiChang And StTrayArm.InitStatus = 0 Then
                    '初始化时若控盘流转上有料盘，将电机失磁，方便拿走料盘
                    Call FMotoFree(Moto_TrayArm_KongPan, 0)
                End If
            End If
        End If
    End If
    If SystemStatus = 1 Then
        Me.msfgBinGrid.Enabled = False
        Me.msfgSocketBin.Enabled = False
        Me.msfgUPHList.Enabled = False
    Else
        Me.msfgBinGrid.Enabled = True
        Me.msfgSocketBin.Enabled = True
        Me.msfgUPHList.Enabled = True
    End If

    If sstTest.Tab = 0 Then
        Call RefreshTestNumRecordGrid
    ElseIf sstTest.Tab = 1 Then
        Call RefreshSocketBinReport
    ElseIf sstTest.Tab = 2 Then
        Call RefreshPFNumRecordGrid
    ElseIf sstTest.Tab = 3 Then
        Call RefreshLPassPerGrid
    ElseIf Me.sstTest.Tab = 4 Then
        Call RefreshTestBinStatues
    ElseIf Me.sstTest.Tab = 5 Then
        Call RefreshQRCodeStatistics
    End If


    If Me.stCount.Tab = 0 Then
        Call RefreshTestBinReport
    ElseIf Me.stCount.Tab = 1 Then
        Call ShowUPHInfo
    ElseIf stCount.Tab = 4 Then
        If UserInfo.AuthList.AnalogTestEn = True And Me.btnAnalogTest.Visible = False Then
            Me.btnAnalogTest.Visible = True       '20220627 高超杰 屏蔽模拟测试   张剑
            Me.btnIOScan.Visible = True
            Me.btnYeildShow.Visible = True
'            Me.BtnBatch.Visible = True
        ElseIf UserInfo.AuthList.AnalogTestEn = False And Me.btnAnalogTest.Visible = True Then
            Me.btnAnalogTest.Visible = False
            Me.btnIOScan.Visible = False
            Me.btnYeildShow.Visible = False
'            Me.BtnBatch.Visible = False
        End If
        
    ElseIf Me.stCount.Tab = 6 Then
        If StTestArmParam.Set_SocketLifeTimeEn = 1 Then
            Me.txtMachineID.Caption = StSocketLifeTime.MachineID
            Me.txtLoadBoardID.Caption = StSocketLifeTime.LoadBoardID
            For i = 0 To 15
                If i < 8 Then
                    Me.txtSocketID(i).Caption = StSocketLifeTime.SocketID((i + 1) * 2 - 1)
                    Me.txtPackage(i).Caption = StSocketLifeTime.Package((i + 1) * 2 - 1)
                
                    Me.txtSocketContactNum(i).Caption = StTestArmParam.Set_StationGoldFingerUseTimes((i + 1) * 2 - 1)
                    StSocketLifeTime.SocketContactNum(i + 1) = StTestArmParam.Set_StationGoldFingerUseTimes((i + 1) * 2 - 1)
                    If StSocketLifeTime.SocketContactNum(i + 1) >= StSocketLifeTime.ShowRedCount((i + 1) * 2 - 1) Then
                        Me.txtSocketContactNum(i).BackColor = &HFF&
                    ElseIf StSocketLifeTime.SocketContactNum(i + 1) >= StSocketLifeTime.ShowYellowCount((i + 1) * 2 - 1) Then
                        Me.txtSocketContactNum(i).BackColor = &HFFFF&
                    Else
                         Me.txtSocketContactNum(i).BackColor = &H80000005
                    End If
                Else
                    Me.txtSocketID(i).Caption = StSocketLifeTime.SocketID((i - 7) * 2)
                    Me.txtPackage(i).Caption = StSocketLifeTime.Package((i - 7) * 2)
                
                    Me.txtSocketContactNum(i).Caption = StTestArmParam.Set_StationGoldFingerUseTimes((i - 7) * 2)
                    StSocketLifeTime.SocketContactNum(i + 1) = StTestArmParam.Set_StationGoldFingerUseTimes((i - 7) * 2)
                    If StSocketLifeTime.SocketContactNum(i + 1) >= StSocketLifeTime.ShowRedCount((i - 7) * 2) Then
                        Me.txtSocketContactNum(i).BackColor = &HFF&
                    ElseIf StSocketLifeTime.SocketContactNum(i + 1) >= StSocketLifeTime.ShowYellowCount((i - 7) * 2) Then
                        Me.txtSocketContactNum(i).BackColor = &HFFFF&
                    Else
                         Me.txtSocketContactNum(i).BackColor = &H80000005
                    End If
                End If
            Next
        Else
            Me.stCount.Tab = 1
        End If
      ElseIf stCount.Tab = 10 Then  '李森 修改二维码加密
        If UserInfo.Userlevel = 4 Then
           For i = 1 To 6
            Me.lbTrayQRCode(i).PasswordChar = ""
           Next
            Me.txtUnloadQR.PasswordChar = ""
        Else
            For i = 1 To 6
                Me.lbTrayQRCode(i).PasswordChar = "*"
           Next
            Me.txtUnloadQR.PasswordChar = "*"
        End If
    
    End If
        
    If StInputArmParam.Set_NoICAutoRunFlag = 1 And Me.btnInputTrayNoICAutoRun.BackColor = &H8000000F Then
        Me.btnInputTrayNoICAutoRun.BackColor = &HFFFF&
    ElseIf StInputArmParam.Set_NoICAutoRunFlag = 0 And Me.btnInputTrayNoICAutoRun.BackColor = &HFFFF& Then
        Me.btnInputTrayNoICAutoRun.BackColor = &H8000000F
    End If

    If OneSTimerFlag > 8 Then           '1秒钟检查一下系统的状态
        '系统运行检查
        If Me.lbSystemStatus.Caption = "运行" Or Me.lbSystemStatus.Caption = "正在停止" Then
            '系统处于运行状态,如果运行时钟未打开，则直接打开
            If Timer(T_SysRunFlag).IsUsed = 0 Then
                Call Timer_Open(T_SysRunFlag)
            Else
                'Debug.Print "T_SysRunFlag.timehold" & CLng(Timer(T_SysRunFlag).TimeHold)
            End If
            '检查系统是否长时间没有动作
            If Timer(T_SysRunFlag).TimeHold > 2000000 Then
'                Call SetAlarm(ABN_Common_WeiZhiYiChang, 0, 0, 0, 999, 999, 999, 4)
'                Call ActionInit
            End If
        Else
            If Timer(T_SysRunFlag).IsUsed = 1 Then
                Call Timer_Close(T_SysRunFlag)
            End If
        End If
        If Me.lbDoorAlarm.BackColor = &HFF& Then
            Me.lbDoorAlarm.BackColor = &H8000000F
        Else
            Me.lbDoorAlarm.BackColor = &HFF&
        End If
        OneSTimerFlag = 1

    Else
        OneSTimerFlag = OneSTimerFlag + 1
    End If
    
    Me.lbEPSetting.Caption = StEPCom.SetEPValue
    Me.lbEPCur.Caption = StEPCom.CheckEPGetCurValue(1)
    Me.lbCleanPadTimes.Caption = "AutoClean/CleanPad:" & StDCParam.CleanICUseNumNow

    If By(OY_Sys_RedLight).StateNow = 1 Then
        picSystemStatus(0).BackColor = &HFF&
    Else
        picSystemStatus(0).BackColor = &H8000000F
    End If

    If By(OY_Sys_YellowLight).StateNow = 1 Then
        picSystemStatus(1).BackColor = &HFFFF&
    Else
        picSystemStatus(1).BackColor = &H8000000F
    End If

    If By(OY_Sys_GreenLight).StateNow = 1 Then
        picSystemStatus(2).BackColor = &HFF00&
    Else
        picSystemStatus(2).BackColor = &H8000000F
    End If

    If Len(frmAutoRun.lbAlarmIndex.Caption) > 0 Then
        If Len(frmAutoRun.lbAlarmName.Caption) = 0 Then
            Call RefreshAlarmShow
        End If
    End If
    
    If StHotControl.Set_HasHotTray = 1 Then
        If stCount.Tab = 5 Then
            Call RefreshTempShow
        End If
    End If
    
    '20220622 高超杰  增加非供应商权限时恢复温度显示
    If UserInfo.UserCode <> "gys" Then
        If TempLableShowType = 1 Then
            TempLableShowType = 0
            Call IniHeatShowLab
        End If
    End If
    
    If StESD.Set_ESDEn = 1 Then
        If stCount.Tab = 7 Then
            Call RefreshESDShow
        End If
    End If
    
    If Set_FangLouCeShowEn = 1 Then
        If stCount.Tab = 9 Then
            Call CeYaDoubleSensorStatueShow '20220606 高超杰  界面显示测压传感器状态
        End If
    End If
    
    Call InitSocketSever '202105 wjs rtc 开端口号
    
    If StTestIC.Set_QuickOpenLotEn <> 0 Then    '20221124 李俊辉 快速建立Lot功能增加模式2，CleanOut完成后点击TrayEnd不结批
        If stCount.Tab = 8 Then
            If StTestIC.LotStatus = 1 Then
                Me.txtLotID.Locked = True
                Me.txtLotID.Enabled = False
                
                Me.txtOPID.Locked = True
                Me.txtOPID.Enabled = False
                
                Me.btnStartLot.Enabled = False
                Me.btnEndLot.Enabled = True
                '20221124 李俊辉 Start Lot将批次选择置灰
                Me.CkICNumEn.Enabled = False
                Me.NewLotICNum.Enabled = False
                Me.FTRTflag(0).Enabled = False
                Me.FTRTflag(1).Enabled = False
            Else
                Me.txtLotID.Locked = False
                Me.txtLotID.Enabled = True
                
                Me.txtOPID.Locked = False
                Me.txtOPID.Enabled = True
                
                Me.btnStartLot.Enabled = True
                Me.btnEndLot.Enabled = False
                '20221124 李俊辉 End Lot将批次选择置亮
                Me.CkICNumEn.Enabled = True
                Me.NewLotICNum.Enabled = True
                Me.FTRTflag(0).Enabled = True
                Me.FTRTflag(1).Enabled = True
            End If
        End If
    End If
    
    
    If StQRCode.Set_QRCodeCheckEn = 1 Then
        For i = 0 To 3
            If Me.WSVision(i).State = 8 Or Me.WSVision(i).State = 9 Then
            '220216 金尚辉 通讯异常时重启通讯
                frmAutoRun.WSVision(i).Close
                frmAutoRun.WSVision(i).Listen
            End If
        Next
    End If
    If StInputArmParam.Set_SiteMappingCheckEn = 1 Then  '2024/1/30 李森 sitemapping状态显示
        Me.lbSiteMappingstatus.Caption = "开启"
        Me.lbSiteMappingstatus.BackColor = &HFFFF&
        If StInputArmParam.SiteMappingCheckFlag = 1 Then
            Me.lbSiteMappingstatus.BackColor = &HFF00&
        End If
    Else
        Me.lbSiteMappingstatus.BackColor = &HFF&
        Me.lbSiteMappingstatus.Caption = "关闭"
    End If
    
    
    '20230325 王莹莹 料盘扫码功能开启后，主界面增加机型显示
    If StQRCode.Set_HasTrayBarcode = 1 And StQRCode.Set_TrayBarcodeCheckEn = 1 Then
        Me.lbTestOrSortMachineType.Visible = True

        If StQRCode.Set_TestOrSortMachineType = 0 Then
            Me.lbTestOrSortMachineType.Caption = "测试分选机"
            Me.lbTestOrSortMachineType.ForeColor = &HFF0000
        Else
            Me.lbTestOrSortMachineType.Caption = "分Bin分选机"
            Me.lbTestOrSortMachineType.ForeColor = &HFF&
        End If
    Else
        Me.lbTestOrSortMachineType.Visible = False
    End If
    
    If StQRCode.Set_HasTrayBarcode = 1 And StQRCode.Set_TrayBarcodeCheckEn = 1 Then
        Call InitTrayBarcodeVision              '20230324 高超杰 料盘扫码枪初始化连接
        If StQRCode.BatchOrderQREnableFlag = 1 Then           '20230325 王莹莹 料盘二维码功能，工单码文本框可输入
            Me.txtBatchOrderQR.Enabled = True
        Else
            Me.txtBatchOrderQR.Enabled = False
        End If
        
        '20230410 王莹莹 增加扫码枪不开启状态区分
        For i = 0 To 6
            If StQRCode.Set_TrayBarcodeIsUsed(i) = 1 Then
                '绿
                Me.lbTrayInfo(i).BackColor = &HFF00&
            Else
                '灰
                Me.lbTrayInfo(i).BackColor = &HC0C0C0
            End If
        Next
    Else
        For i = 0 To 6
            Me.lbTrayInfo(i).BackColor = &HC0C0C0
        Next
    End If
    
    '250102 金尚辉 推广'230802 金尚辉 新增socket触发控件的初始化设置，满足界面显示
    If Check_SocketSensorOpen = 1 Then
        Me.btnSocketHasICSensorCheck.Visible = True
        If UserInfo.AuthList.SocketSensorCheckStrikeEn = True Then
            If StSocketCheck.SocketSensorCheckState = 1 Then
