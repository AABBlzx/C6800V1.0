'''料盘编辑功能:收料盘
''' </summary>
''' <remarks></remarks>
Private Sub btnChangeTrayMatrax_Click(Index As Integer)
On Error GoTo ErrorHandler
    Dim i As Integer
    For i = 1 To StTestIC.PickArmNum
        If BX(StOutputArm.ArmStation(i).SVYaLi).StateNow = 1 Then
            MsgBox ("放料机械手上有料,不能编辑料盘信息")
            Exit Sub
        End If
    Next
    '2014.11.3 cqq 增加条件，运行过程中，不运行进行操作，否则有可能出错
    If SystemStatus = 0 Or SystemStatus = 2 Or SystemStatus = 3 Then
            Unload frmBaseTrayMatrix '20221109 盛嘉涛 增加料盘编辑时先退出再编辑
'        If UserInfo.AuthList.AutoTrayMatrixEn = True Or UserInfo.UserLevel > 3 Then
            frmBaseTrayMatrix.TrayNo = Index + 1
            frmBaseTrayMatrix.Show
'        Else
'            MsgBox ("您无权限进行料盘编辑，请切换用户")
'            Exit Sub
'        End If
    End If
Exit Sub
ErrorHandler:
    Call WriteDebugInfoToLog("btnChangeTrayMatrax_Click发生异常,错误号：" & Err.Number & "  错误信息：" & Err.Description & " 错误行号：" & Erl, 1)      '保存错误的信息
End Sub

''' <summary>
'''料盘编辑功能:进料盘 和 料盘百分比显示
''' </summary>
''' <remarks></remarks>
Private Sub lbTrayCount_Click(Index As Integer)
On Error GoTo ErrorHandler
    Unload frmBaseTrayMatrix '20240115 梁子旋 修复频繁点击料盘界面软件崩溃问题
    If Index = 0 Then
          '2014.11.3 cqq 增加条件，运行过程中，不运行进行操作，否则有可能出错
        If SystemStatus = 0 Or SystemStatus = 2 Or SystemStatus = 3 Then
'            If UserInfo.AuthList.TrayMatrixEn = True Or UserInfo.UserLevel > 3 Then '20200106 迁移条件到料盘编辑界面
                frmBaseTrayMatrix.TrayNo = 0
                frmBaseTrayMatrix.Show
'            Else
'                MsgBox ("您无权限进行料盘编辑，请切换用户")
'                Exit Sub
'            End If
        End If
    ElseIf Index = 8 Or Index = 9 Then
        If SystemStatus = 0 Or SystemStatus = 2 Or SystemStatus = 3 Then
'            If UserInfo.AuthList.TrayMatrixEn = True Or UserInfo.UserLevel > 3 Then '20200106 迁移条件到料盘编辑界面
                '20250107 梁子旋推广8002.0'20230426 涂远程 添加高温盘不能编辑的卡控
                If StInputArmParam.HotTrayNotAllowEidtFlag = 1 Then
                    MsgBox ("取料机械手正在取料中，您无法进行料盘编辑")
                    Exit Sub
                Else
                    frmBaseTrayMatrix.TrayNo = Index - 1
                    frmBaseTrayMatrix.Show
                End If
'            Else
'                MsgBox ("您无权限进行料盘编辑，请切换用户")
'                Exit Sub
'            End If
        End If
    Else
        If TrayShowCountFlag = 0 Then
            TrayShowCountFlag = 1
            Call InitFormAutoRunTrayRecord
        Else
            TrayShowCountFlag = 0
            Call InitFormAutoRunTrayRecord
        End If
    End If
Exit Sub
ErrorHandler:
    Call WriteDebugInfoToLog("lbTrayCount_Click发生异常,错误号：" & Err.Number & "  错误信息：" & Err.Description & " 错误行号：" & Erl, 1)      '保存错误的信息
End Sub
