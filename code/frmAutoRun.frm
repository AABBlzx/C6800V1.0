Public Sub RefreshQRCodeStatistics()
      Me.lbBarCodeCount(0).Caption = StQRCode.TestQRCodePassICCount
      Me.lbBarCodeCount(2).Caption = StQRCode.TestQRCodeFailICCountCheck
      Me.lbBarCodeCount(1).Caption = StQRCode.TestQRCodeFailICCount
      Me.lbBarCodeCount(3).Caption = StQRCode.TestQRCodeICCount
      If Val(Me.lbBarCodeCount(3).Caption) > 0 Then
          Me.lbBarCodePercent(0).Caption = Format(Val(Me.lbBarCodeCount(0).Caption) / Val(Me.lbBarCodeCount(3).Caption), "0.00%")
          Me.lbBarCodePercent(1).Caption = Format(Val(Me.lbBarCodeCount(1).Caption) / Val(Me.lbBarCodeCount(3).Caption), "0.00%")
          'Me.lbBarCodePercent(2).Caption = Format(Val(Me.lbBarCodeCount(2).Caption) / Val(Me.lbBarCodeCount(3).Caption), "0.00%")
      Else
          Me.lbBarCodePercent(0).Caption = "0.00%"
          Me.lbBarCodePercent(1).Caption = "0.00%"
      End If
End Sub

