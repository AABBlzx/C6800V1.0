''' <summary>
''' 界面登录初始化
''' </summary>
''' <remarks></remarks>
Private Sub Form_Load()
On Error GoTo ErrorHandler
    Me.sbAutoRun.Panels(1).Text = "杭州长川科技"
    Me.Caption = StTestIC.MachineName & "控制系统"
    Me.Top = 0
    Me.Left = 0
    Me.sstTest.Tab = 0
    Me.stCount.Tab = 0
    Me.Top = 0
    
    If StTestArmParam.Set_SocketLifeTimeEn = 0 Then
        Me.stCount.TabVisible(6) = False
    End If
    
    If SystemDoorAlarmFlag = 0 Then
        Me.lbDoorAlarm.Visible = False
    End If
    
    Call Timer_Reset(T_CheckSECSExeRun)    '20190111 zhangr添加SECS 5
    frmAutoRun.SecMode.Caption = "SECS-OFF"
    frmAutoRun.SecMode.Visible = False     '不使用
    '20231221 沈延 推广 料盘二维码对比功能
    Dim i As Integer
    Call ReadUnloadBrcodeFile '20230803   张博宇   Unload二维码数据读取
    For i = 1 To 3 '20230803   张博宇   Unload二维码屏蔽自动盘显示
        lbTrayInfoID(i).Visible = False
        lbTrayQRCode(i).Visible = False
        btnCheckIn(i - 1).Visible = False
    Next
    For i = 4 To 6
        lbTrayInfoID(i).Visible = True
        lbTrayQRCode(i).Visible = True
        btnCheckIn(i - 1).Visible = True
        lbTrayInfoID(i).Top = txtUnloadQR.Top + 1000 + 1000 * (i - 4)
        lbTrayQRCode(i).Top = lbTrayInfoID(i).Top
        btnCheckIn(i - 1).Top = lbTrayInfoID(i).Top
    Next
    
    StQRCode.BatchOrderQREnableFlag = 1 '20230407 王莹莹 启动程序时，工单码可输入
    
    '20240112 王莹莹 料盘扫码功能开启后，主界面显示测试结果为SoftBin值，不开启时，显示Bin值，为显示完整，需改字号
    If StQRCode.Set_HasTrayBarcode = 1 And StQRCode.Set_TrayBarcodeCheckEn = 1 Then
        For i = 0 To 15
            frmAutoRun.lbTestBinValue(i).FontSize = "10.5"
            frmAutoRun.lbTestBinValue_8Site(i).FontSize = "10.5"
        Next
    Else
        For i = 0 To 15
            frmAutoRun.lbTestBinValue(i).FontSize = "14"
            frmAutoRun.lbTestBinValue_8Site(i).FontSize = "14"
        Next
    End If

Exit Sub
ErrorHandler:
    Call WriteDebugInfoToLog("Form_Load发生异常,错误号：" & Err.Number & "  错误信息：" & Err.Description & " 错误行号：" & Erl, 1)      '保存错误的信息
End Sub

