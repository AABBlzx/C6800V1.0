Private Sub InitStationBinStatus()
On Error GoTo ErrorHandler
    Dim i As Integer
    For i = 0 To 79
        With Me.lbStationBinStatus(i)
            .Width = Me.lbStationBinStatus(0).Height
            .Left = Me.lbStationBinStatus(0).Left + (i Mod 20) * 310
        End With
    Next
    For i = 160 To 239
        With Me.lbStationBinStatus(i)
            .Width = Me.lbStationBinStatus(0).Height
            .Left = Me.lbStationBinStatus(160).Left + (i Mod 20) * 310
        End With
    Next
Exit Sub
ErrorHandler:
    Call WriteDebugInfoToLog("InitStationBinStatus发生异常,错误号：" & Err.Number & "  错误信息：" & Err.Description & " 错误行号：" & Erl, 1)      '保存错误的信息
End Sub

