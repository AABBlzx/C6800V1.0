''' <summary>
''' Socket Bin统计
''' </summary>
''' <remarks></remarks>
Private Sub RefreshSocketBinReport()
On Error GoTo ErrorHandler
    Dim i, j As Integer
    Dim Sum(16) As Long
    Dim LeftSum(16) As Long
    Dim RightSum(16) As Long
    
    '20231114 许峰 推广兼容32Bin
    Dim binmax As Integer
    If BIN_MAX > 16 Then
        binmax = BIN_MAX
    Else
        binmax = BIN_MAX - 1
    End If
    
    If StTestIC.MachineName = "C6Q160" Then
        If TrayShowCountFlag = 0 Then
            For i = 1 To binmax + 1       '20231114 许峰 推广兼容32Bin
                For j = 1 To 16
                    If j >= 9 Then
                        Me.msfgSocketBin.TextMatrix(i, j) = StTestArmParam.BinCount((j - 8) * 2, i)
                        Me.msfgSocketBin.TextMatrix(i, j + 16) = StTestArmParam.LRBinCount(1, (j - 8) * 2, i)
                        Me.msfgSocketBin.TextMatrix(i, j + 32) = StTestArmParam.LRBinCount(2, (j - 8) * 2, i)
                    Else
                        Me.msfgSocketBin.TextMatrix(i, j) = StTestArmParam.BinCount(j * 2 - 1, i)
                        Me.msfgSocketBin.TextMatrix(i, j + 16) = StTestArmParam.LRBinCount(1, j * 2 - 1, i)
                        Me.msfgSocketBin.TextMatrix(i, j + 32) = StTestArmParam.LRBinCount(2, j * 2 - 1, i)
                    End If
                Next
    
            Next
        Else
            For i = 1 To binmax + 1       '20231114 许峰 推广兼容32Bin
                For j = 1 To 16
                    If j >= 9 Then
                        Sum((j - 8) * 2) = Sum((j - 8) * 2) + StTestArmParam.BinCount((j - 8) * 2, i)
                        LeftSum((j - 8) * 2) = LeftSum((j - 8) * 2) + StTestArmParam.LRBinCount(1, (j - 8) * 2, i)
                        RightSum((j - 8) * 2) = RightSum((j - 8) * 2) + StTestArmParam.LRBinCount(2, 0, i)
                    Else
                        Sum(j * 2 - 1) = Sum(j * 2 - 1) + StTestArmParam.BinCount(j * 2 - 1, i)
                        LeftSum(j * 2 - 1) = LeftSum(j * 2 - 1) + StTestArmParam.LRBinCount(1, j * 2 - 1, i)
                        RightSum(j * 2 - 1) = RightSum(j * 2 - 1) + StTestArmParam.LRBinCount(2, 0, i)
                    End If
                Next
                
            Next
            For i = 1 To binmax + 1       '20231114 许峰 推广兼容32Bin
                For j = 1 To 16
                    If j >= 9 Then
                        If Sum((j - 8) * 2) > 0 Then
                            Me.msfgSocketBin.TextMatrix(i, j) = Format(StTestArmParam.BinCount((j - 8) * 2, i) / Sum((j - 8) * 2), "0.00%")
                        End If
                        If LeftSum((j - 8) * 2) > 0 Then
                            Me.msfgSocketBin.TextMatrix(i, j + 16) = Format(StTestArmParam.LRBinCount(1, (j - 8) * 2, i) / LeftSum((j - 8) * 2), "0.00%")
                        End If
                        If RightSum((j - 8) * 2) > 0 Then
                            Me.msfgSocketBin.TextMatrix(i, j + 32) = Format(StTestArmParam.LRBinCount(2, (j - 8) * 2, i) / RightSum((j - 8) * 2), "0.00%")
                        End If
                    Else
                        If Sum(j * 2 - 1) > 0 Then
                            Me.msfgSocketBin.TextMatrix(i, j) = Format(StTestArmParam.BinCount(j * 2 - 1, i) / Sum(j * 2 - 1), "0.00%")
                        End If
                        If LeftSum(j * 2 - 1) > 0 Then
                            Me.msfgSocketBin.TextMatrix(i, j + 16) = Format(StTestArmParam.LRBinCount(1, j * 2 - 1, i) / LeftSum(j * 2 - 1), "0.00%")
                        End If
                        If RightSum(j * 2 - 1) > 0 Then
                            Me.msfgSocketBin.TextMatrix(i, j + 32) = Format(StTestArmParam.LRBinCount(2, j * 2 - 1, i) / RightSum(j * 2 - 1), "0.00%")
                        End If
                    End If
                Next
            Next
        End If
        
    ElseIf StTestIC.MachineName = "C6Q800S" Then
        If TrayShowCountFlag = 0 Then
            For i = 1 To binmax + 1       '20231114 许峰 推广兼容32Bin
                For j = 1 To 8
                    If j >= 5 Then
                        Me.msfgSocketBin.TextMatrix(i, j) = StTestArmParam.BinCount((j - 4) * 2, i)
                        Me.msfgSocketBin.TextMatrix(i, j + 8) = StTestArmParam.LRBinCount(1, (j - 4) * 2, i)
                        Me.msfgSocketBin.TextMatrix(i, j + 16) = StTestArmParam.LRBinCount(2, (j - 4) * 2, i)
                    Else
                        Me.msfgSocketBin.TextMatrix(i, j) = StTestArmParam.BinCount(j * 2 - 1, i)
                        Me.msfgSocketBin.TextMatrix(i, j + 8) = StTestArmParam.LRBinCount(1, j * 2 - 1, i)
                        Me.msfgSocketBin.TextMatrix(i, j + 16) = StTestArmParam.LRBinCount(2, j * 2 - 1, i)
                    End If
                Next
    
            Next
        Else
            For i = 1 To binmax + 1       '20231114 许峰 推广兼容32Bin
                For j = 1 To 8
                    If j >= 5 Then
                        Sum((j - 4) * 2) = Sum((j - 4) * 2) + StTestArmParam.BinCount((j - 4) * 2, i)
                        LeftSum((j - 4) * 2) = LeftSum((j - 4) * 2) + StTestArmParam.LRBinCount(1, (j - 4) * 2, i)
                        RightSum((j - 4) * 2) = RightSum((j - 4) * 2) + StTestArmParam.LRBinCount(2, 0, i)
                    Else
                        Sum(j * 2 - 1) = Sum(j * 2 - 1) + StTestArmParam.BinCount(j * 2 - 1, i)
                        LeftSum(j * 2 - 1) = LeftSum(j * 2 - 1) + StTestArmParam.LRBinCount(1, j * 2 - 1, i)
                        RightSum(j * 2 - 1) = RightSum(j * 2 - 1) + StTestArmParam.LRBinCount(2, 0, i)
                    End If
                Next
                
            Next
            For i = 1 To binmax + 1       '20231114 许峰 推广兼容32Bin
                For j = 1 To 8
                    If j >= 5 Then
                        If Sum((j - 4) * 2) > 0 Then
                            Me.msfgSocketBin.TextMatrix(i, j) = Format(StTestArmParam.BinCount((j - 4) * 2, i) / Sum((j - 4) * 2), "0.00%")
                        End If
                        If LeftSum((j - 4) * 2) > 0 Then
                            Me.msfgSocketBin.TextMatrix(i, j + 8) = Format(StTestArmParam.LRBinCount(1, (j - 4) * 2, i) / LeftSum((j - 4) * 2), "0.00%")
                        End If
                        If RightSum((j - 4) * 2) > 0 Then
                            Me.msfgSocketBin.TextMatrix(i, j + 16) = Format(StTestArmParam.LRBinCount(2, (j - 4) * 2, i) / RightSum((j - 4) * 2), "0.00%")
                        End If
                    Else
                        If Sum(j * 2 - 1) > 0 Then
                            Me.msfgSocketBin.TextMatrix(i, j) = Format(StTestArmParam.BinCount(j * 2 - 1, i) / Sum(j * 2 - 1), "0.00%")
                        End If
                        If LeftSum(j * 2 - 1) > 0 Then
                            Me.msfgSocketBin.TextMatrix(i, j + 8) = Format(StTestArmParam.LRBinCount(1, j * 2 - 1, i) / LeftSum(j * 2 - 1), "0.00%")
                        End If
                        If RightSum(j * 2 - 1) > 0 Then
                            Me.msfgSocketBin.TextMatrix(i, j + 16) = Format(StTestArmParam.LRBinCount(2, j * 2 - 1, i) / RightSum(j * 2 - 1), "0.00%")
                        End If
                    End If
                Next
            Next
        End If

    End If
Exit Sub
ErrorHandler:
    Call WriteDebugInfoToLog("RefreshSocketBinReport发生异常,错误号：" & Err.Number & "  错误信息：" & Err.Description & " 错误行号：" & Erl, 1)      '保存错误的信息
End Sub


''' <summary>
''' 显示测试结果:Total Pass Fail
''' </summary>
''' <remarks></remarks>
Public Sub ShowOutputTestPFResult()
On Error GoTo ErrorHandler
    Dim i As Integer
    Dim ARM1PassCount, Arm1TestCount, ARM2PassCount, Arm2TestCount As Long
    
    For i = 1 To 8
        If StTestArmParam.TestStationIsUsed(i) = 1 Then
            If TrayShowCountFlag = 0 Then
                frmAutoRun.lbStationPTestNum(StTestArm.ARM1Station(i).frmShowNo).Caption = StTestArmParam.ARM1PassCount(i)
                frmAutoRun.lbStationFTestNum(StTestArm.ARM1Station(i).frmShowNo).Caption = StTestArmParam.ARM1FailCount(i)
                
                frmAutoRun.lbStationPTestNum(StTestArm.ARM2Station(i).frmShowNo + 8).Caption = StTestArmParam.ARM2PassCount(i)
                frmAutoRun.lbStationFTestNum(StTestArm.ARM2Station(i).frmShowNo + 8).Caption = StTestArmParam.ARM2FailCount(i)
                frmAutoRun.lbStationPTestNum(StTestArm.ARM2Station(i).frmShowNo + 16).Caption = StTestArmParam.ARM1PassCount(i) + StTestArmParam.ARM2PassCount(i)
                frmAutoRun.lbStationFTestNum(StTestArm.ARM2Station(i).frmShowNo + 16).Caption = (StTestArmParam.Arm1TestCount(i) + StTestArmParam.Arm2TestCount(i)) - (StTestArmParam.ARM1PassCount(i) + StTestArmParam.ARM2PassCount(i))
            Else
                If StTestArmParam.Arm1TestCount(i) > 0 And StTestArmParam.TestCount(i) > 0 Then
                    frmAutoRun.lbStationPTestNum(StTestArm.ARM1Station(i).frmShowNo).Caption = Format(StTestArmParam.ARM1PassCount(i) / StTestArmParam.Arm1TestCount(i), "0.00%")
                    frmAutoRun.lbStationFTestNum(StTestArm.ARM1Station(i).frmShowNo).Caption = Format((StTestArmParam.Arm1TestCount(i) - StTestArmParam.ARM1PassCount(i)) / StTestArmParam.Arm1TestCount(i), "0.00%")
                    frmAutoRun.lbStationPTestNum(StTestArm.ARM1Station(i).frmShowNo + 16).Caption = Format((StTestArmParam.ARM1PassCount(i) + StTestArmParam.ARM2PassCount(i)) / StTestArmParam.TestCount(i), "0.00%")
                    frmAutoRun.lbStationFTestNum(StTestArm.ARM1Station(i).frmShowNo + 16).Caption = Format((StTestArmParam.TestCount(i) - (StTestArmParam.ARM1PassCount(i) + StTestArmParam.ARM2PassCount(i))) / StTestArmParam.TestCount(i), "0.00%")
                Else
                    frmAutoRun.lbStationPTestNum(StTestArm.ARM1Station(i).frmShowNo).Caption = "0.00%"
                    frmAutoRun.lbStationFTestNum(StTestArm.ARM1Station(i).frmShowNo).Caption = "0.00%"
                    frmAutoRun.lbStationPTestNum(StTestArm.ARM1Station(i).frmShowNo + 16).Caption = "0.00%"
                    frmAutoRun.lbStationFTestNum(StTestArm.ARM1Station(i).frmShowNo + 16).Caption = "0.00%"
                End If
                If StTestArmParam.Arm2TestCount(i) > 0 And StTestArmParam.TestCount(i) > 0 Then
    
                    frmAutoRun.lbStationPTestNum(StTestArm.ARM2Station(i).frmShowNo + 8).Caption = Format(StTestArmParam.ARM2PassCount(i) / StTestArmParam.Arm2TestCount(i), "0.00%")
                    frmAutoRun.lbStationFTestNum(StTestArm.ARM2Station(i).frmShowNo + 8).Caption = Format((StTestArmParam.Arm2TestCount(i) - StTestArmParam.ARM2PassCount(i)) / StTestArmParam.Arm2TestCount(i), "0.00%")
                    frmAutoRun.lbStationPTestNum(StTestArm.ARM2Station(i).frmShowNo + 8).Caption = Format((StTestArmParam.ARM1PassCount(i) + StTestArmParam.ARM2PassCount(i)) / StTestArmParam.TestCount(i), "0.00%")
                    frmAutoRun.lbStationFTestNum(StTestArm.ARM2Station(i).frmShowNo + 8).Caption = Format((StTestArmParam.TestCount(i) - (StTestArmParam.ARM1PassCount(i) + StTestArmParam.ARM2PassCount(i))) / StTestArmParam.TestCount(i), "0.00%")
                Else
                    frmAutoRun.lbStationPTestNum(StTestArm.ARM2Station(i).frmShowNo + 8).Caption = "0.00%"
                    frmAutoRun.lbStationFTestNum(StTestArm.ARM2Station(i).frmShowNo + 8).Caption = "0.00%"
                    frmAutoRun.lbStationPTestNum(StTestArm.ARM2Station(i).frmShowNo + 8).Caption = "0.00%"
                    frmAutoRun.lbStationFTestNum(StTestArm.ARM2Station(i).frmShowNo + 8).Caption = "0.00%"
    
                End If
            End If
    
            '2014.7.22 cqq 统计两个Arm良率偏差，显示
            ARM1PassCount = ARM1PassCount + StTestArmParam.ARM1PassCount(i)
            Arm1TestCount = Arm1TestCount + StTestArmParam.Arm1TestCount(i)
            ARM2PassCount = ARM2PassCount + StTestArmParam.ARM2PassCount(i)
            Arm2TestCount = Arm2TestCount + StTestArmParam.Arm2TestCount(i)
        End If
    Next

    If TrayShowCountFlag = 0 Then
        frmAutoRun.lbStationPTestNum(24).Caption = ARM1PassCount
        frmAutoRun.lbStationFTestNum(24).Caption = Arm1TestCount - ARM1PassCount

        frmAutoRun.lbStationPTestNum(25).Caption = ARM2PassCount
        frmAutoRun.lbStationFTestNum(25).Caption = Arm2TestCount - ARM2PassCount

        frmAutoRun.lbStationPTestNum(26).Caption = ARM1PassCount + ARM2PassCount
        frmAutoRun.lbStationFTestNum(26).Caption = (Arm1TestCount + Arm2TestCount) - (ARM1PassCount + ARM2PassCount)
    Else
        If Arm1TestCount > 0 Then
            frmAutoRun.lbStationPTestNum(24).Caption = Format(ARM1PassCount / Arm1TestCount, "0.00%")
            frmAutoRun.lbStationFTestNum(24).Caption = Format((Arm1TestCount - ARM1PassCount) / Arm1TestCount, "0.00%")
        Else
            frmAutoRun.lbStationPTestNum(24).Caption = "0.00%"
            frmAutoRun.lbStationFTestNum(24).Caption = "0.00%"
        End If

        If Arm2TestCount > 0 Then
            frmAutoRun.lbStationPTestNum(25).Caption = Format(ARM2PassCount / Arm2TestCount, "0.00%")
            frmAutoRun.lbStationFTestNum(25).Caption = Format((Arm2TestCount - ARM2PassCount) / Arm2TestCount, "0.00%")
        Else

            frmAutoRun.lbStationPTestNum(25).Caption = "0.00%"
            frmAutoRun.lbStationFTestNum(25).Caption = "0.00%"
        End If

        If Arm1TestCount > 0 Or Arm2TestCount > 0 Then
            frmAutoRun.lbStationPTestNum(26).Caption = Format((ARM1PassCount + ARM2PassCount) / (Arm1TestCount + Arm2TestCount), "0.00%")
            frmAutoRun.lbStationFTestNum(26).Caption = Format(((Arm1TestCount + Arm2TestCount) - (ARM1PassCount + ARM2PassCount)) / (Arm1TestCount + Arm2TestCount), "0.00%")
        Else

            frmAutoRun.lbStationPTestNum(26).Caption = "0.00%"
            frmAutoRun.lbStationFTestNum(26).Caption = "0.00%"
        End If
    End If
Exit Sub
ErrorHandler:
    Call WriteDebugInfoToLog("ShowOutputTestPFResult发生异常,错误号：" & Err.Number & "  错误信息：" & Err.Description & " 错误行号：" & Erl, 1)      '保存错误的信息
End Sub

''' <summary>
''' 初始化工位选择界面
''' </summary>
''' <remarks></remarks>
Public Sub InitSelectStation()
On Error GoTo ErrorHandler

    Dim i, Rows, Cols As Integer
    Dim VGap, HGap As Double
    For i = 1 To Me.labStationSelect.UBound
        Unload Me.labStationSelect(i)
    Next
    
    For i = 1 To Me.lbStationName.UBound
        Unload Me.lbStationName(i)
    Next
    
    If StTestIC.SiteType = 24 Then
        Rows = 2
        Cols = 4
    ElseIf StTestIC.SiteType = 22 Then
        Rows = 2
        Cols = 2
    ElseIf StTestIC.SiteType = 12 Then
        Rows = 1
        Cols = 2
    ElseIf StTestIC.SiteType = 14 Then
        Rows = 1
        Cols = 4
    ElseIf StTestIC.SiteType = 28 Then
        Rows = 2
        Cols = 8
    ElseIf StTestIC.SiteType = 11 Then  '230920 林钊  推广C6800C_V1.0性能提升1*1工位模式代码
        Rows = 1
        Cols = 1
    End If
    
    VGap = (1890 - Rows * 450) / (Rows + 1)
    HGap = (5055 - Cols * 495) / (Cols + 1)
    
    For i = 1 To Rows * Cols - 1
        Load labStationSelect(i)
    Next
    For i = 0 To Rows * Cols - 1
        With labStationSelect(i)
            .Height = 450
            .Width = 495
            If Rows = 2 Then
                .Top = VGap * (i Mod 2 + 1) + (i Mod 2) * 450 + VGap * 2 / 3
            Else
                .Top = 1890 / 2
            End If
            If Rows = 2 Then
                If StTestIC.SitesNum < 16 Then
                    .Left = HGap * (i \ 2 + 1) + 495 * (i \ 2)
                Else
                    .Left = HGap * (i \ 2 + 1) + 495 * (i \ 2)
                End If
            Else
                .Left = HGap * (i + 1) + 495 * i
            End If
            .Visible = True
            If TIF(i + 1).SMStationIndex = 0 Then
                .Caption = "NA"
            Else
                .Caption = CStr(TIF(i + 1).SMStationIndex)
            End If
            If StTestArmParam.TestStationIsUsed(i + 1) = 1 Then
                .BackColor = &HFF00&
            Else
                .BackColor = &HE0E0E0
            End If
        End With
        
    Next
    
    For i = 1 To Rows * Cols - 1
        Load Me.lbStationName(i)
    Next
    
    For i = 0 To Rows * Cols - 1
        With lbStationName(i)
            .Height = 285
            .Width = 330
            .Top = labStationSelect(i).Top - 50 - 285
            If StTestIC.SitesNum < 16 Then
                .Left = labStationSelect(i).Left + (495 - 330) / 2
            Else
                .Left = labStationSelect(i).Left + (495 - 330) / 2
            End If
            .Visible = True
            .Caption = GetStationName(i + 1)
        End With
    Next
    
    For i = 0 To lbStationName.UBound
        Me.lbStationName(i).Left = Me.lbStationName(i).Left + 300
        Me.labStationSelect(i).Left = Me.labStationSelect(i).Left + 300
    Next
Exit Sub
ErrorHandler:
    Call WriteDebugInfoToLog("InitSelectStation发生异常,错误号：" & Err.Number & "  错误信息：" & Err.Description & " 错误行号：" & Erl, 1)      '保存错误的信息
End Sub

