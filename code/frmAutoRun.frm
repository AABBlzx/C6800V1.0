''' <summary>
''' 工单码输入内容，切换相应的分Bin内容（BinMapping配置文件）
''' </summary>
''' <remarks></remarks>
'20230325 王莹莹 工单码文本框输入内容后，按回车，触发的函数
Private Sub txtBatchOrderQR_KeyUp(KeyCode As Integer, Shift As Integer)
    Dim BatchQR As String
    
    If StQRCode.Set_BatchOrderQRInputMode = 1 Then
        Dim Timer1, Timer2 As Double
        BarCodeFisrtReadTimer(2) = RdSysTime '20250103 钟海 工单码不能键盘输入,只能扫码枪输入
        'Timer1 = BarCodeFisrtReadTimer(2) - BarCodeFisrtReadTimer(0)
        Timer2 = BarCodeFisrtReadTimer(2) - BarCodeFisrtReadTimer(1)
        If Timer2 > Set_Logintime Then  '默认100
            Me.txtBatchOrderQR.Text = ""
        End If
    End If
    
    If KeyCode <> 13 Then
        Exit Sub
    End If
    
    BatchQR = Replace(Me.txtBatchOrderQR.Text, vbCrLf, "")
    BatchQR = Replace(BatchQR, " ", "")
        
    If frmTestSoftBinSet.GetBinmapByBatchQR(BatchQR) = "" Then
        Call ClearAlarmShow
        frmAutoRun.lbResolution.Text = "切换BinMaping失败，没有合适的分Bin配置文件，请添加相应配置文件后，再扫工单码"
        Exit Sub
    End If
    
    StQRCode.Set_BatchOrderQR = BatchQR
    Call SaveProductParam("Set_BatchOrderQR", StQRCode.Set_BatchOrderQR)
    
    Call frmTestSoftBinSet.ReadbinmapMsg(StTestIC.Set_SoftBinToTConfigPreName & "_" & StTestIC.Set_SoftBinToTConfigFixName)
    Call frmTestSoftBinSet.LoadbinmapSelectErrcode
    Call InitBinRecordGrid
End Sub


