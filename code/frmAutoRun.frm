''' <summary>
''' 服务端 创建链接多个客户端
''' </summary>
''' <remarks></remarks>
Public Sub Findfreeandloadsck()
    Dim i As Integer
    Dim j As Integer
    For i = 0 To RTMServer.UBound
        If RTMServer(i).State <> 7 Then
            upi = i
            RTMServer(i).Close
            Exit Sub
        End If
    Next i   '如果上面的没有找到，然后增加数组的大小，使用新的空闲listen
       
    upi = RTMServer.UBound + 1
    If upi < StRTMParam.Set_RTMnum Then
        Load RTMServer(upi)
        RTMServer(i).Close
    Else   '加载到设定得数量时要卸载一些控件，但要保证几个可以进行链接
        For j = StRTMParam.Set_RTMnum - 1 To RTMServer.UBound
            RTMServer(j).Close
            Unload RTMServer(j)
        Next
    End If
End Sub

'2021/8/25 林兴 因接受档案内容长度过长，分次读取
Private Sub RTMServer_DataArrival(Index As Integer, ByVal bytesTotal As Long)
On Error GoTo error
    Dim Getstr As String
    Dim i As Integer
    If Me.RTMServer(Index).State = 7 Then
        If bytesTotal < 8192 Then
                Me.RTMServer(Index).GetData Getstr
            SocketData = SocketData & Getstr
            If InStr(1, SocketData, Chr(10)) = 0 Then
                Call WriteRTMLog("接收数据没有结束符")
                Debug.Print "接收数据没有结束符"
            Else
                StRTMParam.TCPStr() = Split(SocketData, Chr(10))
                For i = 0 To (UBound(StRTMParam.TCPStr()) - 1)
                    Debug.Print Time & "获取HOST信息："; SocketData
                    Call WriteRTMLog("RTM>>>Handler $ Index:" & Index & " $ Get To:" & SocketData)  '2021/9/4 林兴 优化Log 记录主机编号
                    StRTMParam.RTMindex = Index
                    Call HostToEQP(StRTMParam.TCPStr(i))
                Next
                SocketData = ""
            End If
        Else
            Me.RTMServer(Index).GetData Getstr
            SocketData = SocketData & Getstr
            If Right(SocketData, 1) = Chr(10) Then
                StRTMParam.TCPStr() = Split(SocketData, Chr(10))
                SocketData = ""
                For i = 0 To (UBound(StRTMParam.TCPStr()) - 1)
'                        Dim S As Boolean
                    Debug.Print InStr(1, StRTMParam.TCPStr(0), Chr(10))
                    Debug.Print "获取StSocket信息："; StRTMParam.TCPStr(i)
                    Debug.Print Time
                    Call WriteRTMLog("RTM>>>Handler$ Index:" & Index & " $ Get To:" & StRTMParam.TCPStr(i))     '2021/9/4 林兴 优化Log 记录主机编号
                    Call HostToEQP(StRTMParam.TCPStr(i))
                    StRTMParam.TCPStr(i) = ""
                Next
            End If
            Exit Sub
        End If
    Else
        Debug.Print "通信未连接"
    End If
    Exit Sub
error:
    Call WriteRTMLog("Error---RTMServer_DataArrival:" & SocketData)
    Debug.Print "接收Socket数据出错"
End Sub

Private Sub RTMServer_Error(Index As Integer, ByVal Number As Integer, Description As String, ByVal Scode As Long, ByVal source As String, ByVal HelpFile As String, ByVal HelpContext As Long, CancelDisplay As Boolean)
