''' <summary>
'''测试功能开启和关闭
''' </summary>
''' <remarks></remarks>
Private Sub cmdTestMode_Click()
On Error GoTo ErrorHandler
    Dim answer As String
    If SystemStatus = 0 Then
        If BX(S_LoaderTray_TuoPanDaoWei).StateNow = 1 Or BX(S_LoaderTray_GongLiaoWeiJianSu).StateNow = 1 Or BX(S_LoaderTray_TuoPanPiDaiJianCe).StateNow = 1 Then
            MsgBox ("请拿走进料料盘，再进行此操作")
            Exit Sub
        ElseIf BX(S_UnloadTray_T1LiaoPanDaoWei).StateNow = 1 Or BX(S_UnloadTray_T2LiaoPanDaoWei).StateNow = 1 Or BX(S_UnloadTray_T3LiaoPanDaoWei).StateNow = 1 Then
            MsgBox ("请拿走自动盘料盘，再进行此操作")
            Exit Sub
        ElseIf BX(S_OutputArm_ShouGongPan1).StateNow = 1 Or BX(S_OutputArm_ShouGongPan2).StateNow = 1 Or BX(S_OutputArm_ShouGongPan3).StateNow = 1 Then
            MsgBox ("请拿走手工盘料盘，再进行此操作")
            Exit Sub
        Else
            If CheckArmHasIC(1) = True Then
                MsgBox ("取料机械手上有IC，请取走IC再进行此操作")
                Exit Sub
            ElseIf CheckArmHasIC(2) = True Then
                MsgBox ("放料机械手上有IC，请取走IC再进行此操作")
                Exit Sub
            ElseIf CheckArmHasIC(3) = True Then
                MsgBox ("测压机械手Arm1上有IC，请取走IC再进行此操作")
                Exit Sub
            ElseIf CheckArmHasIC(4) = True Then
                MsgBox ("测压机械手Arm2上有IC，请取走IC再进行此操作")
                Exit Sub
            End If
        End If
        If UserInfo.AuthList.TestModeEn = True Then
            answer = MsgBox("您确定要修改测试功能吗？", vbExclamation + vbYesNo, "请确认")
            If answer = vbYes Then
                If StTestArmParam.Set_TestEn = 1 Then
                   Me.lbTestMode.Caption = "OFF Line"
                   Me.lbTestMode.BackColor = RGB(255, 0, 0)
                   StTestArmParam.Set_TestEn = 0
                Else
                    Me.lbTestMode.Caption = "ON Line"
                    Me.lbTestMode.BackColor = RGB(0, 255, 0)
                    StTestArmParam.Set_TestEn = 1
                    Unload frmReportStationInfo            '20221020 张剑 在online模拟测试如果开启就关闭
                    StDebugFlag.AnalogFlag = 0
                End If
                Call SaveProductParam("Set_TestEn", CStr(StTestArmParam.Set_TestEn))
                If StTestArmParam.Set_TestEn = 0 Then
                    StTestIC.UseTestEn = 0
                Else
                    StTestIC.UseTestEn = 1
                End If
                '20221124吕武杰增加切换offline对应显示bin设置
                Call InitTestBinInfo
                '20240227 王莹莹 料盘二维码功能开启后，料盘分Bin显示SoftBin值
                If StQRCode.Set_HasTrayBarcode = 1 And StQRCode.Set_TrayBarcodeCheckEn = 1 Then
                    Call frmAutoRun.InitAutoFormSoftBinToT
                Else
                    Call InitAutoFormBinToT
                End If
                StSECSParam.SendECChangeToHostFlag = 1
            End If
        Else
            MsgBox ("您无权限进行测试模式编辑，请切换用户")
        End If
    End If
Exit Sub
ErrorHandler:
    Call WriteDebugInfoToLog("cmdTestMode_Click发生异常,错误号：" & Err.Number & "  错误信息：" & Err.Description & " 错误行号：" & Erl, 1)      '保存错误的信息
End Sub

'''<summary>
''' 检查机械手上是否有IC
''' </summary>
''' <remark>state：1 检查取料机械手上是否有IC  state：2 检查放料机械手是否有IC 3:测压机械手Arm1是否有IC 4:测压机械手Arm2是否有IC </remark>
Private Function CheckArmHasIC(ByVal State As Integer) As Boolean
    Dim i As Integer
    Dim result As Boolean
    result = False
    If State = 1 Then
        For i = 1 To StTestIC.PickArmNum
            If BX(StInputArm.ArmStation(i).SVYaLi).StateNow = 1 Then
                result = True
                Exit For
            End If
        Next
    ElseIf State = 2 Then
        For i = 1 To StTestIC.PickArmNum
            If BX(StOutputArm.ArmStation(i).SVYaLi).StateNow = 1 Then
                result = True
                Exit For
            End If
        Next
    ElseIf State = 3 Then
        For i = 1 To StTestIC.SitesNum
            If BX(StTestArm.ARM1Station(i).SVYaLi).StateNow = 1 Then
                result = True
                Exit For
            End If
        Next
     ElseIf State = 4 Then
        For i = 1 To StTestIC.SitesNum
            If BX(StTestArm.ARM2Station(i).SVYaLi).StateNow = 1 Then
                result = True
                Exit For
            End If
        Next
    End If
    CheckArmHasIC = result
End Function

