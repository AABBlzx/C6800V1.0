''' <summary>
''' 监控系统的扫描周期
''' 20230814 沈延 推广2022/6/26 高超杰 C001：由于系统卡顿，电机和指示灯信号存在延时，导致测压电机下降取料压伤人员手臂
''' </summary>
Public Sub CheckAvgTickOutTime()
10    On Error GoTo ErrorHandler
20        If StInputArmParam.Set_AvgTickSetValue > 1000 Then
30            If SystemStopFlag = 0 And SystemAlarmPauseFlag = 0 And SystemPauseFlag = 0 And SystemStatus = 1 And StActionLoop.OneCycleFlag <> 1 Then
40                AutoRunCheckIntoTime = AutoRunCheckIntoTime + 1
50                If AutoRunCheckIntoTime = 10 Then                                               '达到1秒
60                    If StSysLoopTick.AvgTick >= StInputArmParam.Set_AvgTickSetValue Then        '系统扫描时间大于等于设定值
70                        CheckAvgTickTime = CheckAvgTickTime + 1                                 '则累加1次
80                        If CheckAvgTickTime = 9 Then
90                            TickIndex = 1                                                       '第9次时，输出一次Tick值
100                       ElseIf CheckAvgTickTime >= 10 Then                                      '如果连续10次，则报警
110                           CheckAvgTickTime = 0
120                           AutoRunCheckIntoTime = 0
130                           If CheckAlarmList(ABN_Common_AvgTickError) = False Then
140                               Call SetAlarm(ABN_Common_AvgTickError, 1, 2, 1, 999, 999, 999, 2)
150                           End If
160                       End If
170                   Else
180                       CheckAvgTickTime = 0
190                   End If
200               ElseIf AutoRunCheckIntoTime > 10 Then
210                   AutoRunCheckIntoTime = 0
220               End If
230           End If
240       End If
250       Exit Sub
ErrorHandler:
260          Debug.Print "CheckAvgTickOutTime Error"
270          Call WriteDebugInfoToLog("CheckAvgTickOutTime发生异常,错误号：" & Err.Number & "  错误信息：" & Err.Description & " 错误行号：" & Erl, 1)      '保存错误的信息
End Sub

